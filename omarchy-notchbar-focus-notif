#!/usr/bin/env python3
import sys, json, subprocess, re

if len(sys.argv) < 2:
    sys.exit(0)

try:
    notif = json.loads(sys.argv[1])
except Exception:
    sys.exit(0)

try:
    raw = subprocess.check_output(["hyprctl", "clients", "-j"], timeout=1)
    clients = json.loads(raw)
except Exception:
    clients = []

if not clients:
    sys.exit(0)

app = (notif.get("appName") or notif.get("app") or "").strip()
summary = (notif.get("summary") or "").strip()
body = (notif.get("body") or "").strip()

target = None

# 1. Match app name or class directly (if not generic notify-send)
if app and app.lower() not in ("notify-send", "omarchy-action", "omarchy", ""):
    app_lower = app.lower()
    for c in clients:
        c_class = (c.get("class") or "").lower()
        c_init = (c.get("initialClass") or "").lower()
        if app_lower == c_class or app_lower == c_init or app_lower in c_class:
            target = c
            break

# 2. Extract potential keyword tokens from summary and body
if not target:
    tokens = []
    if summary:
        tokens.extend([t for t in re.split(r"[\s\-_:·/]+", summary) if len(t) >= 2])
    if body:
        tokens.extend([t for t in re.split(r"[\s\-_:·/]+", body) if len(t) >= 2])
    
    skip = {"needs", "attention", "finished", "ready", "error", "notification", "info", "the", "and", "for", "with", "from"}
    filtered_tokens = [t.lower() for t in tokens if t.lower() not in skip]
    
    for tok in filtered_tokens:
        for c in clients:
            title = (c.get("title") or "").lower()
            init_title = (c.get("initialTitle") or "").lower()
            c_class = (c.get("class") or "").lower()
            if tok in title or tok in init_title or tok == c_class:
                target = c
                break
        if target:
            break

# 3. Fallback for notify-send or generic: focus active/recent terminal window
if not target:
    for c in clients:
        c_class = (c.get("class") or "").lower()
        if c_class in ("kitty", "foot", "alacritty", "ghostty", "wezterm", "org.omarchy.agent", "xterm"):
            target = c
            break

if target:
    addr = target.get("address")
    ws_name = str(target.get("workspace", {}).get("name") or "")
    if ws_name.startswith("special:"):
        special_name = ws_name.split(":", 1)[1]
        subprocess.run(["hyprctl", "dispatch", f"hl.dsp.special_workspace({{ name = \"{special_name}\" }})"], timeout=1)
    
    cmd_lua = f"hl.dsp.focus({{ window = \"address:{addr}\" }})"
    res = subprocess.run(["hyprctl", "dispatch", cmd_lua], capture_output=True, timeout=1)
    if res.returncode != 0:
        subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{addr}"], timeout=1)
